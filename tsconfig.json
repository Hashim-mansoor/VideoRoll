{
  "compilerOptions": {
    "declaration": true,
    "allowJs": true,
    "target": "esnext",
    "module": "esnext",
    "strict": true,
    "sourceMap": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "./src",
    "baseUrl": "./",
    "paths": {
      "*": ["types/*"],
      "src/*": ["./src/*"]
    },
    "lib": ["es2021", "dom"],
    "typeRoots": ["./node_modules/@types"],
    "types": ["chrome", "node", "webextension-polyfill", "lodash-es"]
  },
  "isolatedModules": true,
  "exclude": [
    "node_modules",
    "src/**/*.html",
    "src/popup/content/main.ts",
    "src/options/index.ts",
    "src/inject/jungle.js"
  ],
  "include": [
    "src/inject/VideoRoll.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/**/*.vue",
    "src/popup/content"
  ]
}
